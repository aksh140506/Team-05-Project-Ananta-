# BankSathi FastAPI Backend Environment Configuration
# Copy to backend/.env before running uvicorn locally. Never commit backend/.env to Git.

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Database URL: Supabase PostgreSQL / PostGIS connection string
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:your_supabase_db_password@db.your_project_ref.supabase.co:5432/postgres

# Must match SYNC_VERIFY_KEY in root .env / Android Secrets for HMAC-SHA256 delta-sync verification
SYNC_VERIFY_KEY=SYNC_VERIFY_KEY_DEFAULT_VALUE

# Firebase Project ID used to verify incoming Firebase Auth Bearer ID tokens
FIREBASE_PROJECT_ID=gen-lang-client-0766244733

# JWT signing secret for Supabase DB email/password sessions (generate a strong 32+ char secret)
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# Optional: Supabase Auth JWT Secret (Project Settings -> API -> JWT Settings) if also using Supabase GoTrue tokens
SUPABASE_JWT_SECRET=

# Comma-separated emails automatically granted ADMIN or VERIFIER roles upon sign-in/register
ADMIN_EMAILS=nikhilsoni8557@gmail.com
VERIFIER_EMAILS=verifier@banksathi.in

# Set to true ONLY during offline laptop demo/testing when Google public JWT certs cannot be fetched
FIREBASE_ALLOW_UNVERIFIED_OFFLINE_DEMO=false

# Optional Firebase App Check enforcement (log-only when false for local Swagger/Postman testing)
REQUIRE_APP_CHECK=false

# Comma-separated allowed CORS origins (never use * on authenticated APIs)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# Per-IP/User sliding-window rate limit (requests per minute)
RATE_LIMIT_PER_MIN=60
