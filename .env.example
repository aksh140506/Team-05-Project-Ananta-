# Firebase AI Logic uses App Check attestation; no GEMINI_API_KEY is required.

# Bhashini ULCA Speech API credentials (enter real values in the AI Studio Secrets panel)
BHASHINI_USER_ID=BHASHINI_USER_ID_DEFAULT_VALUE
BHASHINI_ULCA_API_KEY=BHASHINI_ULCA_API_KEY_DEFAULT_VALUE
BHASHINI_PIPELINE_ID=BHASHINI_PIPELINE_ID_DEFAULT_VALUE

# Optional HMAC-SHA256 verification key for signed FastAPI delta-sync UPDATE_PACKAGE bundles
SYNC_VERIFY_KEY=SYNC_VERIFY_KEY_DEFAULT_VALUE

# Optional FastAPI backend base URL (e.g. http://10.0.2.2:8000/ for Android Emulator local demo)
BANKSATHI_API_BASE_URL=BANKSATHI_API_BASE_URL_DEFAULT_VALUE
